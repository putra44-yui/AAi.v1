{
  "name": "aai-v0",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-31",
  "keep_vars": true,
  "vars": {
    "AAI_ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.25,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.25
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.25
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/login",
      "/login/"
    ]
  },
  "ratelimits": [
    {
      "name": "AAI_WEB_SEARCH_LIMITER",
      "namespace_id": "311021",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "AAI_COMPANION_RATE_LIMITER",
      "namespace_id": "311022",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "previews": {
    "vars": {
      "AAI_ENVIRONMENT": "preview"
    },
    "ratelimits": [
      {
        "name": "AAI_WEB_SEARCH_LIMITER",
        "namespace_id": "93110401",
        "simple": {
          "limit": 12,
          "period": 60
        }
      },
      {
        "name": "AAI_COMPANION_RATE_LIMITER",
        "namespace_id": "93110402",
        "simple": {
          "limit": 8,
          "period": 60
        }
      }
    ]
  }
}
