# Contoh nama binding untuk Cloudflare Worker (nilai asli simpan di Variables & Secrets).
# Jangan commit .env.local atau .dev.vars.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-private-service-role-key
OPENROUTER_API_KEY=replace-with-private-openrouter-key

# Opsional: model utama. GPT-OSS Free hanya tersedia via pilihan uji manual di UI.
OPENROUTER_MAIN_MODEL=qwen/qwen3.6-plus
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_HTTP_REFERER=https://aai.family
OPENROUTER_X_TITLE=AAi Keluarga
AAI_REASONING_PREVIEW_ENABLED=false
